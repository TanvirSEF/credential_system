# Application
APP_PORT=3000
APP_VERSION=local

# Supabase Auth is currently required even when application data uses another PostgreSQL host.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Application data: Supabase Postgres, Neon, RDS, local Postgres, etc.
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://user:password@host:5432/credential_vault
DIRECT_URL=

# existing: schema/RLS were already applied (for example with pnpm db:push).
# migrate: installer applies committed migrations and Supabase RLS policies.
DATABASE_SETUP_MODE=existing

# supabase-rls: database has Supabase roles/auth.uid() and db/rls.sql is installed.
# application: regular PostgreSQL; DB must remain private because authorization is enforced by server actions.
DATABASE_AUTHORIZATION_MODE=supabase-rls

# Any S3-compatible service: Cloudflare R2, AWS S3, MinIO, Backblaze B2, Wasabi, etc.
STORAGE_PROVIDER=s3-compatible
STORAGE_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=credential-vault
STORAGE_S3_ACCESS_KEY_ID=your-access-key
STORAGE_S3_SECRET_ACCESS_KEY=your-secret-key
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=https://files.example.com

# Legacy R2_* names remain supported for existing installations.
